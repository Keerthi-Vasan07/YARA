# YARA frontend environment (Vite).
# Copy to `.env` for local development. Vite inlines these at BUILD time, so the
# dev server / build must be restarted after any change here.

# Base URL of the YARA backend. Leave empty to use the dev proxy in vite.config.ts
# (which forwards /api and /opendap to http://127.0.0.1:8000).
VITE_API_BASE_URL=

# MapTiler key for the Cesium basemap layers.
VITE_MAPTILER_API_KEY=

# Origin of the separate GLORYS "Detailed Subsurface Analysis" frontend.
# This is a standalone Vite app with its own backend; YARA only opens it in a new
# tab with the selected 1x1 degree grid as query parameters.
#
#   local development : http://localhost:5173   (glorys .../frontend/vite.config.ts -> server.port)
#   production        : https://<your-deployed-glorys-frontend>
#
# In development this may be left blank and YARA falls back to localhost:5173.
# In a PRODUCTION build it must be set: there is no localhost fallback, and the
# "Detailed Subsurface Analysis" button reports a configuration error instead of
# opening an unreachable tab.
VITE_GLORYS_APP_URL=

# Optional analytics.
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
